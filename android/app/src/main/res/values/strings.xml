    <string name="perm_access_title">Notification access</string>
    <string name="perm_access_why">Lets the app read notifications to show them on your PC.</string>
    <string name="perm_access_hint">If the switch is greyed out, open App info, tap the three dots and choose Allow restricted settings.</string>
    <string name="perm_post_title">Show notifications</string>
    <string name="perm_post_why">For the connection status and file transfers.</string>
    <string name="perm_battery_title">Background activity</string>
    <string name="perm_battery_why">Keeps the link alive with the screen off.</string>
