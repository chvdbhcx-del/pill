    <!-- Onboarding -->
    <string name="ob1_title">Your phone, on your PC</string>
    <string name="ob1_body">See phone notifications in Pill, reply from the keyboard and move files both ways. Everything stays on your home network.</string>
    <string name="ob2_title">Pair in seconds</string>
    <string name="ob2_body">In Pill open Settings, then Phone, and turn on Phone link. Scan the QR code with this app, or type the code by hand.</string>
    <string name="ob3_title">A few permissions</string>
    <string name="ob3_body">Pill Phone needs them to mirror notifications and stay connected. You can allow each one with a single tap on the next screen.</string>

