    <!-- Pairing -->
    <string name="pair_title">Pair with your PC</string>
    <string name="pair_headline">Link this phone to Pill</string>
    <string name="pair_step1_title">Open Pill on your PC</string>
    <string name="pair_step1_body">Go to Settings, then Phone, and turn on Phone link.</string>
    <string name="pair_step2_title">Scan the QR code</string>
    <string name="pair_step2_body">Point this phone at the code shown on the PC.</string>
    <string name="pair_step3_title">Same Wi-Fi</string>
    <string name="pair_step3_body">Both devices must be on the same network. Nothing leaves it.</string>
    <string name="pair_manual_title">Enter the code</string>
    <string name="pair_manual_body">Type the address and the 8-letter code shown next to the QR code in Pill.</string>
    <string name="field_address">PC address</string>
    <string name="field_address_hint" translatable="false">192.168.1.20:41717</string>
    <string name="field_code">Pairing code</string>
    <string name="field_code_hint" translatable="false">AB3D9XKQ</string>
    <string name="pair_confirm_title">Pair with %1$s?</string>
    <string name="pair_confirm_body">This phone will show its notifications on that PC and exchange files with it. Continue only if you started this on your own computer.</string>
    <string name="pair_working">Pairing…</string>
    <string name="pair_success">Paired with %1$s</string>
    <string name="pair_success_body">Setting up the connection</string>
    <string name="pair_err_code_title">That code did not work</string>
    <string name="pair_err_code_body">Codes are valid once, for five minutes. Show a new QR code in Pill and try again.</string>
    <string name="pair_err_unreachable_title">Can\'t reach the PC</string>
    <string name="pair_err_unreachable_body">Check that Pill is running with Phone link on, and that both devices share the same Wi-Fi.</string>
    <string name="pair_err_link_title">Not a Pill pairing code</string>
    <string name="pair_err_link_body">Open the QR code shown in Pill, or enter the address and code by hand.</string>
    <string name="pair_err_refused_title">The PC refused to pair</string>
    <string name="pair_err_refused_body">Try showing a new code in Pill and pairing again.</string>

