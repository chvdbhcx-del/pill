<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing is backed up (the pairing token stays on the phone). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
