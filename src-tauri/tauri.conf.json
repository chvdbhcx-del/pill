{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pill",
  "version": "0.6.1",
  "identifier": "com.pill.dev",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; worker-src 'none'" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNjJCRjVFMTBCMDZGNDgKUldSSWI3QVFYcjlpUWJTODQzV2REdFk1a2d4Q0RMam9uOWZmNDBhajQyLzVuWWlOYUVEeUxJTUkK",
      "endpoints": ["https://github.com/chvdbhcx-del/pill/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
